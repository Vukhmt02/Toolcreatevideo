# ============================================
# ToolCreateVideo - Configuration
# ============================================

# Google AI Studio API Key (Veo 3.1 + Gemini image)
# Lấy tại: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-3.1-flash-image
# Optional legacy Imagen model. Leave empty when using Gemini image models.
IMAGEN_MODEL=
VEO_MODEL=veo-3.1-generate-preview
ALLOW_IMAGE_FALLBACK=false

# Optional Google Flow browser automation
FLOW_ENABLED=false
FLOW_CDP_URL=http://127.0.0.1:9222
FLOW_URL=https://flow.google.com/
FLOW_CONCURRENCY=3

# ============================================
# OmniVoice TTS Service (Giọng nói AI chất lượng cao)
# Repo: github.com/Le-Ngoc-Tu/OmniVoice_TTS_Service_api
# Chạy server trên máy có GPU (Colab, RunPod...) rồi điền URL vào đây
# ============================================

# URL của OmniVoice server (ví dụ qua ngrok hoặc Colab tunnel)
# Ví dụ: https://abc123.ngrok-free.app
# Để trống → tự động dùng Edge TTS (miễn phí, không cần GPU)
OMNIVOICE_URL=

# API key của OmniVoice server (khớp với TTS_API_KEY trong .env server)
# Để trống nếu server không bật xác thực
OMNIVOICE_API_KEY=

# ============================================
# Server settings
# ============================================
HOST=127.0.0.1
PORT=8000

# FFmpeg path (để trống nếu đã cài trong PATH)
FFMPEG_PATH=

# Thư mục lưu output
OUTPUT_DIR=storage/projects
TEMP_DIR=storage/temp
