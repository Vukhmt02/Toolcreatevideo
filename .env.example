# ============================================
# ToolCreateVideo - Configuration
# ============================================

# Google AI Studio API Key (Veo 3.1 + Gemini image)
# Lấy tại: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-3.1-flash-image
# Optional legacy Imagen model. Leave empty when using Gemini image models.
IMAGEN_MODEL=
VEO_MODEL=veo-3.1-generate-preview
ALLOW_IMAGE_FALLBACK=false

# Optional Google Flow browser automation
FLOW_ENABLED=false
FLOW_CDP_URL=http://127.0.0.1:9222
FLOW_URL=https://flow.google.com/
FLOW_CONCURRENCY=3

# ElevenLabs là dịch vụ giọng đọc duy nhất.
# Tạo API key: https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=true

# ============================================
# Server settings
# ============================================
HOST=127.0.0.1
PORT=8000

# FFmpeg path (để trống nếu đã cài trong PATH)
FFMPEG_PATH=

# Thư mục lưu output
OUTPUT_DIR=storage/projects
TEMP_DIR=storage/temp
